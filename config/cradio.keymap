#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        bs_colon: backspace_colon {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q &kp W &kp F &kp P &kp G   &kp J &kp L &kp U &kp Y &kp ESC
                &ht LSHFT A &ht LALT R &ht LCTRL S &ht LGUI T &kp D
                &kp H &ht RGUI N &ht RCTRL E &ht RALT I &ht RSHFT O
                &kp Z &kp X &kp C &kp V &kp B   &kp K &kp M &kp COMMA &kp DOT &kp FSLH
                &kp TAB &lt 2 ENTER &lt 1 SPACE &bs_colon COLON BSPC
            >;
        };

        right_layer {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
                &kp PG_UP &kp HOME &kp PG_DN &trans &trans   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp SEMI
                &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
                &trans &trans &trans &trans
            >;
        };

        left_layer {
            bindings = <
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp EQUAL &kp PLUS
                &kp LPAR &kp LBKT &kp LBRC &trans &trans     &kp SQT &kp MINUS &kp RBRC &kp RBKT &kp RPAR
                &trans &trans &trans &kp TILDE &kp LT        &kp GT &kp UNDER &kp GRAVE &trans &kp BSLH
                &trans &trans &trans &kp DEL
            >;
        };

        tri_layer {
            bindings = <
                &trans &trans &trans &trans &trans   &kp C_BRI_UP &kp C_BRI_DN &trans &trans &trans
                &bootloader &kp C_PREV &kp C_PP &kp C_NEXT &trans   &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &trans &bootloader
                &bt BT_SEL 0 &bt BT_SEL 1 &trans &bt BT_CLR &trans   &trans &trans &trans &trans &sys_reset
                &trans &trans &trans &trans
            >;
        };
    };
};
